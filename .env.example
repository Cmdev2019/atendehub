# Frontend - AtendeHub

# API Configuration
# Em produção: também usado como build arg do `docker compose -f docker-compose.prod.yml`
# (nginx builda o front estático nesse momento — não dá pra trocar depois sem rebuild).
VITE_API_URL=http://localhost:3001/api/v1

# WebSocket Configuration (URL base — o namespace /ws é adicionado pelo cliente)
VITE_WS_URL=http://localhost:3001

# Environment
VITE_ENV=development

# App Configuration
VITE_APP_NAME=AtendeHub
VITE_APP_VERSION=0.1.0

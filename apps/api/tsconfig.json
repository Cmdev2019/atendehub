{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    // B-86 (TypeScript 6): o que o Node 24 já tem. O @types/node 24 deixou de
    // declarar o `at()` de arrays para alvos antigos.
    "lib": ["ES2023"],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    // B-86: o TypeScript 6 liga o `strict` inteiro por padrão; a API usa só as
    // três checagens abaixo.
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    // B-86: o TypeScript 6 não inclui mais todos os @types sozinho — só os
    // que declaram globais (process, describe/expect, Express.Multer).
    "types": ["node", "jest", "multer"]
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}

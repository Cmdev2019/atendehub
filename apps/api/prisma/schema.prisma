// ─────────────────────────────────────────────────────────────────────────────
// AtendeHub — Prisma Schema
// Banco: PostgreSQL 16
// ORM:   Prisma 5+
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═════════════════════════════════════════════════════════════════════════════

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum Role {
  SUPER_ADMIN  // acesso total ao sistema (equipe interna)
  ADMIN        // admin da empresa
  SUPERVISOR   // supervisor de atendimento
  AGENT        // atendente
}

// B-65 (ADR-0019): estado do atendente, trocado só por ele mesmo. Online
// recebe o aviso de conversa nova e pega da fila; Offline não. Presença
// manual, não pela conexão — fechar a aba não muda nada.
enum Availability {
  ONLINE
  OFFLINE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  QR_CODE      // aguardando scan do QR
  ERROR
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  EMAIL
  CHAT         // chat do site
}

// ⚠️ B-49: WAITING e OPEN são os únicos status considerados "ativos" para o
// índice único parcial `conversations_active_per_contact_key` (migration
// `20260801211919_b49_conversation_active_unique_per_contact` — no máximo 1
// conversa ativa por contato). Adicionar um novo status que também deva
// contar como "ativo" (ex.: um status intermediário de espera) exige, no
// MESMO commit: (1) nova migration ajustando o `WHERE` do índice parcial —
// nunca editar a migration já aplicada; (2) atualizar o array em
// `ConversationService#findActiveConversation`. Esquecer qualquer um dos
// dois reabre a race condition do B-49 (2 conversas ativas pro mesmo
// contato) só para o status novo.
enum ConversationStatus {
  WAITING      // na fila, sem atendente
  OPEN         // em atendimento
  RESOLVED     // resolvida pelo atendente
  CLOSED       // encerrada (timeout ou finalização)
}

// B-32: motivo do encerramento, informado pelo atendente ao clicar em
// "Encerrar" — sem isso não dava pra distinguir chamado resolvido de
// abandonado/sem solução nos números do dashboard.
enum ConversationResolution {
  RESOLVED
  UNRESOLVED
  CANCELLED // encerrada pelo atendente sem atender — exige `resolutionNote` (B-36)
}

enum SenderType {
  AGENT
  CLIENT
  BOT
  SYSTEM       // mensagens automáticas (ex: "Conversa transferida")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT_CARD
  TEMPLATE     // mensagem de template HSM
  REACTION
  DELETED
}

enum MessageStatus {
  PENDING      // aguardando envio
  SENT         // enviado para o servidor
  DELIVERED    // entregue ao dispositivo
  READ         // lido
  FAILED       // falhou
}

// B-66 (ADR-0019, M-21): a fila é compartilhada — só MANUAL é aplicada e
// aceita pela API ("quem atender primeiro"). ROUND_ROBIN e LEAST_BUSY ficam
// no enum só por histórico; se a distribuição automática voltar, vem com uma
// ADR nova.
enum QueueStrategy {
  ROUND_ROBIN  // não aplicada (B-66)
  MANUAL       // fila compartilhada: os atendentes do setor pegam da fila
  LEAST_BUSY   // não aplicada (B-66)
}

// B-35: o que uma opção do menu de auto-atendimento faz quando o contato
// responde com o número/rótulo dela.
enum AutoAttendanceAction {
  ROUTE_TO_DEPARTMENT // encaminha para um departamento (fila ativa dele é resolvida na hora)
  ROUTE_TO_QUEUE      // encaminha direto para uma fila específica
  END_CONVERSATION    // encerra sem atendente (resolution=UNRESOLVED)
}

// ═════════════════════════════════════════════════════════════════════════════
// EMPRESA (root do multi-tenant)
// ═════════════════════════════════════════════════════════════════════════════

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique           // usado como subdomínio: slug.atendehub.com
  logoUrl     String?
  plan        Plan     @default(FREE)
  isActive    Boolean  @default(true)
  maxAgents   Int      @default(5)       // limite do plano
  maxChannels Int      @default(2)
  trialEndsAt DateTime?
  // M-04/B-61: fuso IANA da empresa — horário comercial, "hoje" e períodos
  // de relatório são calculados nele (o servidor roda em UTC).
  timezone    String   @default("America/Sao_Paulo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               User[]
  departments         Department[]
  whatsappConnections WhatsAppConnection[]
  contacts            Contact[]
  conversations       Conversation[]
  queues              Queue[]
  tags                Tag[]
  webhooks            Webhook[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  autoAttendanceFlow  AutoAttendanceFlow?

  @@map("companies")
}

// ═════════════════════════════════════════════════════════════════════════════
// USUÁRIO
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  email        String
  passwordHash String
  role         Role      @default(AGENT)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  phone        String?
  lastSeenAt   DateTime?
  // B-72 (M-08): access tokens emitidos antes deste instante são recusados —
  // troca/reset de senha encerra as sessões abertas sem precisar listar cada
  // token na blacklist.
  sessionsRevokedAt DateTime?
  // B-65 (ADR-0019): começa Offline; logout e desativação voltam para Offline
  availability          Availability @default(OFFLINE)
  availabilityChangedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments   Department[]   @relation("UserDepartments")
  conversations Conversation[] @relation("AgentConversations")
  messages      Message[]
  notes         InternalNote[]
  auditLogs     AuditLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  // Único globalmente (B-20) — não só por empresa: o login (auth.service.ts#validateUser)
  // busca por e-mail sem companyId (a tela de login não pede empresa), então duas
  // empresas com o mesmo e-mail cadastrado resolveriam login de forma ambígua.
  // Pré-requisito do auto-cadastro público de empresas (B-9).
  @@unique([email])
  @@index([companyId])
  @@map("users")
}

// ─── Refresh tokens armazenados no banco (revogação individual) ──────────────
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ═════════════════════════════════════════════════════════════════════════════
// DEPARTAMENTO
// ═════════════════════════════════════════════════════════════════════════════

model Department {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  color       String   @default("#6366f1")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users               User[]               @relation("UserDepartments")
  queues              Queue[]
  whatsappConnections WhatsAppConnection[]
  conversations       Conversation[]
  autoAttendanceMenuOptions AutoAttendanceMenuOption[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

// ═════════════════════════════════════════════════════════════════════════════
// FILA DE ATENDIMENTO
// ═════════════════════════════════════════════════════════════════════════════

model Queue {
  id           String        @id @default(cuid())
  companyId    String
  departmentId String?
  name         String
  strategy     QueueStrategy @default(MANUAL)
  maxWaitSecs  Int           @default(300)    // SLA: tempo máximo na fila
  // B-114 (ADR-0019, regra 19): SLA do atendimento — tempo máximo do Atender
  // ao Encerrar, contado no expediente (null = setor sem SLA do atendimento)
  maxServiceSecs Int?
  greetingMsg  String?                        // mensagem automática ao entrar
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  conversations Conversation[]
  autoAttendanceMenuOptions AutoAttendanceMenuOption[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("queues")
}

// ═════════════════════════════════════════════════════════════════════════════
// AUTO-ATENDIMENTO (B-35)
// ═════════════════════════════════════════════════════════════════════════════

// Config única por empresa (1:1) — saudação/horário/inatividade/encerramento.
// Menu de opções vive em AutoAttendanceMenuOption (1:N). Estado de "onde o
// contato está no menu agora" é efêmero e fica no Redis, não aqui.
model AutoAttendanceFlow {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  isActive               Boolean  @default(false)
  greetingMessage        String?  @db.Text // fallback quando a fila resolvida não tem Queue.greetingMsg próprio
  businessHours          Json?    // { mon: [{start:"09:00",end:"18:00"}], tue: [...], ... } — dia ausente = fechado
  outOfHoursMessage      String?  @db.Text
  inactivityTimeoutSecs  Int?     // silêncio do contato após o menu ser enviado
  inactivityMessage      String?  @db.Text
  closingMessage         String?  @db.Text // enviada ao encerrar automaticamente (inatividade ou opção "encerrar")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  menuOptions AutoAttendanceMenuOption[]

  @@map("auto_attendance_flows")
}

model AutoAttendanceMenuOption {
  id           String               @id @default(cuid())
  flowId       String
  order        Int                  // "1 - Suporte", "2 - Financeiro"...
  label        String
  action       AutoAttendanceAction
  departmentId String?              // usado quando action=ROUTE_TO_DEPARTMENT
  queueId      String?              // usado quando action=ROUTE_TO_QUEUE
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  flow       AutoAttendanceFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  department Department?        @relation(fields: [departmentId], references: [id])
  queue      Queue?             @relation(fields: [queueId], references: [id])

  @@unique([flowId, order])
  @@index([flowId])
  @@map("auto_attendance_menu_options")
}

// ═════════════════════════════════════════════════════════════════════════════
// CONEXÃO WHATSAPP
// ═════════════════════════════════════════════════════════════════════════════

model WhatsAppConnection {
  id             String           @id @default(cuid())
  companyId      String
  departmentId   String?
  name           String                            // "Comercial", "Financeiro"
  sessionName    String           @unique          // ID na Evolution API
  phone          String?                           // preenchido após conexão
  profileName    String?
  profilePicture String?
  status         ConnectionStatus @default(DISCONNECTED)
  battery        Int?
  platform       String?                           // "android", "ios", "web"
  qrCode         String?          @db.Text         // base64 temporário
  lastSeenAt     DateTime?
  apiToken       String?                           // token na Evolution API
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id])
  conversations Conversation[]
  messages      Message[]

  @@index([companyId])
  @@index([sessionName])
  @@map("whatsapp_connections")
}

// ═════════════════════════════════════════════════════════════════════════════
// CONTATO
// ═════════════════════════════════════════════════════════════════════════════

model Contact {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  phone       String
  email       String?
  avatarUrl   String?
  channel     Channel  @default(WHATSAPP)
  isBlocked   Boolean  @default(false)
  metadata    Json?    // dados extras por canal (handle Instagram, etc.)
  anonymizedAt DateTime? // preenchido quando um titular exerce direito de exclusão (B-17/LGPD) —
                         // o registro permanece (conversas/mensagens são histórico legítimo da
                         // empresa), mas name/phone/email/avatarUrl/metadata são substituídos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tags          Tag[]          @relation("ContactTags")

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, phone])
  @@map("contacts")
}

// ═════════════════════════════════════════════════════════════════════════════
// CONVERSA
// ═════════════════════════════════════════════════════════════════════════════

model Conversation {
  id                   String             @id @default(cuid())
  companyId            String
  contactId            String
  agentId              String?
  departmentId         String?
  queueId              String?
  whatsappConnectionId String?
  status               ConversationStatus @default(WAITING)
  channel              Channel            @default(WHATSAPP)
  unreadCount          Int                @default(0)
  lastMessageAt        DateTime?
  lastMessagePreview   String?            // preview para a lista
  slaBreachedAt        DateTime?          // quando o SLA da espera foi violado
  // B-66 (ADR-0019, regra 15): o ciclo de espera atual — início (o "tempo na
  // fila" e a ordem do "Pegar próxima") e prazo do SLA (null = sem SLA)
  waitingSince         DateTime?
  waitSlaDueAt         DateTime?
  // B-114 (ADR-0019, regras 18 a 21): o ciclo do atendimento atual — início
  // (a conversa saiu da fila com alguém), prazo (null = sem SLA do
  // atendimento) e estouro
  attendedAt           DateTime?
  serviceSlaDueAt      DateTime?
  serviceSlaBreachedAt DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  resolution           ConversationResolution? // motivo do encerramento (B-32) — null em conversas encerradas antes deste campo existir
  resolutionNote       String? // justificativa do atendente — obrigatória quando resolution=CANCELLED (B-36)
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact             @relation(fields: [contactId], references: [id])
  agent       User?               @relation("AgentConversations", fields: [agentId], references: [id])
  department  Department?         @relation(fields: [departmentId], references: [id])
  queue       Queue?              @relation(fields: [queueId], references: [id])
  whatsapp    WhatsAppConnection? @relation(fields: [whatsappConnectionId], references: [id])
  messages    Message[]
  tags        Tag[]               @relation("ConversationTags")
  notes       InternalNote[]

  @@index([companyId, status])
  @@index([companyId, contactId])
  @@index([companyId, agentId])
  @@index([companyId, lastMessageAt])
  // B-49: existe também um índice ÚNICO PARCIAL — no máximo 1 conversa por
  // (companyId, contactId) enquanto status IN (WAITING, OPEN) — criado à mão
  // na migration `..._b49_conversation_active_unique_per_contact`
  // (`conversations_active_per_contact_key`). O Prisma não tem `WHERE` na
  // sintaxe de `@@unique`/`@@index` (sem suporte a índice parcial na DSL até
  // a v5), então não dá pra declarar aqui — só documentar pra ninguém achar
  // que é dead code numa introspecção futura e derrubar sem querer.
  // Conversas RESOLVED/CLOSED do mesmo contato continuam coexistindo livre
  // (histórico de atendimentos passados) — só o estado ATIVO é protegido.
  // Ver ConversationService#upsertFromWebhook.
  @@map("conversations")
}

// ═════════════════════════════════════════════════════════════════════════════
// MENSAGEM
// ═════════════════════════════════════════════════════════════════════════════

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String?       // userId quando for agente
  senderType     SenderType
  content        String?       @db.Text
  type           MessageType   @default(TEXT)
  externalId     String?       // ID da mensagem no WhatsApp/Evolution
  // C-09/B-58: conexão de WhatsApp pela qual a mensagem passou (copiada da
  // conversa). Faz parte da unicidade do externalId — ver @@unique abaixo.
  whatsappConnectionId String?
  status         MessageStatus @default(SENT)
  isDeleted      Boolean       @default(false)
  isEdited       Boolean       @default(false)
  quotedMessageId String?      // mensagem citada
  metadata       Json?         // reaction, forwarded, etc.
  // B-76 (M-01): efeitos do webhook que ainda faltam para esta mensagem
  // (prévia, auto-atendimento, eventos, mídia). Cada etapa sai da lista ao
  // terminar; um retry roda só o que sobrou. Mensagem criada fora do webhook
  // (painel, bot) nasce com a lista vazia — o eco dela não refaz nada.
  pendingWebhookSteps String[] @default([])
  sentAt         DateTime      @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id])
  whatsapp       WhatsAppConnection? @relation(fields: [whatsappConnectionId], references: [id], onDelete: SetNull)
  attachments    Attachment[]

  @@index([conversationId])
  @@index([conversationId, sentAt])
  // B-48: era @@index (não bloqueava duplicata) — vira @@unique pra fechar a
  // corrida de idempotência (findFirst+create não é atômico) no nível que
  // realmente garante consistência sob concorrência real: o Postgres. NULL
  // não colide (mensagem de agente sem externalId ainda não é afetada) —
  // ver MessageService#createUnique.
  // C-09/B-58: a unicidade passou a ser POR CONEXÃO. O WhatsApp usa o mesmo
  // id de mensagem nos dois lados de uma conversa: quando duas conexões
  // cadastradas no AtendeHub conversavam entre si (dois números da mesma
  // empresa, ou de duas empresas clientes), a 2ª gravação colidia com a 1ª
  // e a mensagem sumia — e status/exclusão por externalId alcançavam a linha
  // da outra empresa.
  @@unique([whatsappConnectionId, externalId])
  @@map("messages")
}

// ═════════════════════════════════════════════════════════════════════════════
// ANEXO
// ═════════════════════════════════════════════════════════════════════════════

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  url       String  // URL no MinIO
  mimeType  String
  fileName  String?
  size      Int?    // bytes
  width     Int?    // para imagens/vídeos
  height    Int?
  duration  Int?    // para áudio/vídeo em segundos

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

// ═════════════════════════════════════════════════════════════════════════════
// TAG
// ═════════════════════════════════════════════════════════════════════════════

model Tag {
  id        String  @id @default(cuid())
  companyId String
  name      String
  color     String  @default("#6366f1")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[] @relation("ConversationTags")
  contacts      Contact[]      @relation("ContactTags")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("tags")
}

// ═════════════════════════════════════════════════════════════════════════════
// NOTA INTERNA
// ═════════════════════════════════════════════════════════════════════════════

model InternalNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
  @@map("internal_notes")
}

// ═════════════════════════════════════════════════════════════════════════════
// WEBHOOK EXTERNO
// ═════════════════════════════════════════════════════════════════════════════

model Webhook {
  id        String   @id @default(cuid())
  companyId String
  name      String
  url       String
  events    String[]  // ex: ["message.received", "conversation.created"]
  secret    String    // HMAC para validação
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("webhooks")
}

// ═════════════════════════════════════════════════════════════════════════════
// NOTIFICAÇÃO IN-APP
// ═════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  type      String   // ex: "new_conversation", "mentioned", "sla_breach"
  title     String
  body      String?
  data      Json?    // payload extra (conversationId, etc.)
  readAt    DateTime?
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([companyId])
  @@map("notifications")
}

// ═════════════════════════════════════════════════════════════════════════════
// AUDITORIA
// ═════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  action    String   // ex: "conversation.transferred", "user.created"
  entity    String   // ex: "Conversation", "User"
  entityId  String
  before    Json?    // estado anterior
  after     Json?    // estado posterior
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id])

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

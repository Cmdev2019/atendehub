# ─────────────────────────────────────────────────────────────────────────────
# AtendeHub — Variáveis de ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
#
# ⚠️  NUNCA comita o arquivo .env com valores reais!
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicação ─────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_USER=atendehub
POSTGRES_PASSWORD=<gerar_senha_aleatoria>

POSTGRES_DB=atendehub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL completa usada pelo Prisma
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/atendehub?schema=atendehub

# ── Redis ─────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<gerar_senha_aleatoria_ou_deixar_vazio>

REDIS_URL=redis://:password@localhost:6379

# ── Storage S3 (mídia) ────────────────────────────────────────────────────────
# Desenvolvimento: MinIO local (docker-compose.override.yml). Produção:
# Cloudflare R2 (B-64) — ver "Storage de mídia (Cloudflare R2)" no RUNBOOK. O
# prefixo MINIO_ é histórico: em produção as credenciais são as do token do R2.
# IMPORTANTE: Configure valores reais em produção/staging!
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MINIO_ROOT_USER=<seu_usuario_aleatorio>
MINIO_ROOT_PASSWORD=<sua_senha_gerada_acima>
# Em produção vem do docker-compose.prod.yml (https://${MEDIA_STORAGE_HOST}) —
# um valor aqui é ignorado lá.
MINIO_ENDPOINT=http://localhost:9000
# Endereço PÚBLICO da mídia (C-07/B-59). Obrigatório em produção, com https —
# ex. https://media.atendehub.com (bloco `media.` do infra/nginx/nginx.conf).
# A API assina com o MINIO_ENDPOINT e troca só a origem da URL por esta.
# Vazio em dev: a URL sai com o MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=atendehub-media
# R2: auto. MinIO: us-east-1.
MINIO_REGION=us-east-1
# true (padrão): a API cria o bucket e revoga qualquer política pública a cada
# boot (MinIO). false: bucket gerenciado no painel do provedor (R2 — fixado
# assim no docker-compose.prod.yml).
MINIO_MANAGE_BUCKET=true

# Bucket é privado (B-38) — mídia é servida por URL assinada (presigned GET).
# Tempo de vida em segundos da URL antes de expirar.
MEDIA_SIGNED_URL_EXPIRATION=600

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=<obter_da_evolution_api>
EVOLUTION_SERVER_URL=http://localhost:8080
# URL que a Evolution chama a cada evento (deve ser acessível pelo container).
# B-82: o mecanismo é o webhook GLOBAL da Evolution (WEBHOOK_GLOBAL_URL no
# docker-compose, que lê esta mesma variável do .env da raiz) — as instâncias
# não têm mais webhook próprio. A API só usa este valor ao desligar o webhook
# próprio de instâncias antigas.
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3001/api/v1/webhooks/evolution

# ── Fila de webhook — retry/backoff (B-39) ─────────────────────────────────────
# Falha transitória (Postgres/Redis/MinIO fora do ar, timeout da Evolution) tenta
# de novo automaticamente até WEBHOOK_ATTEMPTS vezes, com backoff exponencial
# a partir de WEBHOOK_BACKOFF ms. Esgotadas as tentativas (ou erro classificado
# como permanente), o job cai na DLQ (queue "webhook-dlq") em vez de ser perdido.
WEBHOOK_ATTEMPTS=8
# Backoff exponencial customizado (delay = INITIAL * MULTIPLIER^tentativa) —
# com os defaults: 5s, 10s, 20s, 40s, 80s, 160s, 320s (8 tentativas)
WEBHOOK_BACKOFF_INITIAL=5000
WEBHOOK_BACKOFF_MULTIPLIER=2
# Tempo máximo (ms) para UM processamento antes do Bull marcar como timeout
WEBHOOK_TIMEOUT=30000
# Quantos jobs concluídos/falhos manter no Redis por observabilidade (0 = nenhum)
WEBHOOK_REMOVE_ON_COMPLETE=500
WEBHOOK_REMOVE_ON_FAIL=50

# ── JWT (Autenticação) ────────────────────────────────────────────────────────
# CRÍTICO: Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Nunca use valores padrão em produção!
JWT_SECRET=<gerar_com_comando_acima>

JWT_EXPIRES_IN=15m

# CRÍTICO: Use um valor DIFERENTE de JWT_SECRET
JWT_REFRESH_SECRET=<gerar_com_comando_acima_diferente>

JWT_REFRESH_EXPIRES_IN=7d

# ── Cadastro público de empresas (B-85) ───────────────────────────────────────
# false desliga POST /auth/register-company (403). Cada empresa nova ganha
# conexões de WhatsApp gratuitas — sem verificação de e-mail nem CAPTCHA
# ainda, convém desligar num ambiente aberto.
SIGNUP_ENABLED=true
# Teto de cadastros por IP por dia (além de 3/min por IP na rota)
SIGNUP_DAILY_LIMIT_PER_IP=5

# ── CORS (Origem do Frontend) ─────────────────────────────────────────────────
# Múltiplas origens: separar por vírgula (espaços em volta são ignorados — B-93) (ex.: https://app.dominio.com,https://admin.dominio.com)
# CRÍTICO em produção/staging: obrigatório e nunca "*" — o boot falha (process.exit)
# se ausente (cairia no default de dev) ou se contiver "*" (incompatível com credentials:true).
CORS_ORIGINS=http://localhost:3000

# ── Monitoramento de erros (B-18) ─────────────────────────────────────────────
# Opcional — sem preencher, o Sentry não é inicializado (no-op seguro, não
# quebra o boot). Crie um projeto Node.js em sentry.io (ou GlitchTip
# self-hosted, compatível com o mesmo SDK) e cole o DSN aqui.
SENTRY_DSN=

# ── Throttle (Rate Limiting) ──────────────────────────────────────────────────
# Limite geral: por usuário autenticado (token válido) ou por IP nas rotas
# sem token (C-04). Contador no Redis, compartilhado entre réplicas.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Proxies confiáveis para calcular o IP do cliente (X-Forwarded-For).
# Vazio: 1 em produção (só o nginx), desligado em dev. Com um balanceador na
# frente do nginx, usar 2. Ver src/shared/rate-limit/trust-proxy.ts.
TRUST_PROXY=

# ─────────────────────────────────────────────────────────────────────────────
# INSTRUÇÕES DE SETUP
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Copie este arquivo para .env
#    $ cp .env.example .env
#
# 2. Gere secrets fortes:
#    $ node -e "console.log('JWT_SECRET:', require('crypto').randomBytes(64).toString('hex'))"
#    $ node -e "console.log('JWT_REFRESH_SECRET:', require('crypto').randomBytes(64).toString('hex'))"
#
# 3. Preenchha todos os valores com <...> no .env
#
# 4. Configure seu banco de dados:
#    $ npm run db:migrate
#    $ npm run db:seed
#
# 5. Inicie o servidor:
#    $ npm run start:dev
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  SECURITY WARNING
# ─────────────────────────────────────────────────────────────────────────────
# - NUNCA comita .env com valores reais
# - NUNCA compartilhe valores de secrets
# - MUDE as senhas padrão em produção
# - Use variáveis de ambiente em deployment
# - Rotate secrets regularmente
# ─────────────────────────────────────────────────────────────────────────────
